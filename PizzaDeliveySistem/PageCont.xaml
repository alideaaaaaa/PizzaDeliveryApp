<Page x:Class="PizzaDeliveySistem.PageCont"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PizzaDeliveySistem"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="PageCont">

    <Grid Background="Bisque" Height="450" Width="900">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="90"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Date Personale" FontFamily="Arial" FontSize="20" Foreground="#FF805810"  
        FontWeight="Bold" VerticalAlignment="Center"/>
            
            <Label Grid.Row="1" Content="Nume complet:" FontFamily="Arial" FontSize="20" Foreground="#FF805810"  
        FontWeight="Bold" VerticalAlignment="Center"/>
            <Label Grid.Row="2" Name="labelNume" FontFamily="Arial" FontSize="20" Foreground="#FF805810"  
         VerticalAlignment="Center"/>
            
            
            <Label Grid.Row="3" Content="User name:" FontFamily="Arial" FontSize="20" Foreground="#FF805810"  
        FontWeight="Bold" VerticalAlignment="Center"/>
            <Label Grid.Row="4" Name="labelUser" FontFamily="Arial" FontSize="20" Foreground="#FF805810"  
         VerticalAlignment="Center"/>
            
            <Label Grid.Row="5" Content="Data nasterii:" FontFamily="Arial" FontSize="20" Foreground="#FF805810"  
FontWeight="Bold" VerticalAlignment="Center"/>
            <Label Grid.Row="6" Name="labelData" FontFamily="Arial" FontSize="20" Foreground="#FF805810"  
 VerticalAlignment="Center"/>

            <Label Grid.Row="7" Content="Email:" FontFamily="Arial" FontSize="20" Foreground="#FF805810"  
FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox Grid.Row="8" FontFamily="Arial" FontSize="20" 
                     Margin="5" Foreground="#FF805810" VerticalAlignment="Center" Name="textBoxEmail"/>

            <Label Grid.Row="9" Content="Adresa:" FontFamily="Arial" FontSize="20" Foreground="#FF805810"  
FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox Grid.Row="10" FontFamily="Arial" FontSize="20" Foreground="#FF805810" VerticalAlignment="Center"
                     Margin="5" Name="textBoxAdresa"/>
            <Grid Grid.Row="11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="15,20" Content="Salveaza modificari" FontSize="12" FontFamily="Arial" Background="#FF805820" 
                Foreground="#FFEEECF3" Click="Button_Click" />
                <Button Grid.Column="1" Margin="15,20" Content="Sterge cont" FontSize="12" FontFamily="Arial" Background="#FF805820" 
Foreground="#FFEEECF3" Click="Button_Click_3" />
            </Grid>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="90"/>
            </Grid.RowDefinitions>
            <ListBox Grid.Row="1" Margin="10" Name="listBox" FontFamily="Arial" FontSize="15"/>
            <Label Grid.Row="0" Content="Inbox" FontFamily="Arial" FontSize="50" Foreground="#FF805810"  
FontWeight="Bold" VerticalAlignment="Center"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="10,30" FontSize="15" FontFamily="Arial" TextChanged="TextBox_TextChanged" Name="textBoxCautare"/>
                <Button Grid.Column="1" Margin="15,20" Content="Goleste inbox" FontSize="15" FontFamily="Arial" Background="#FF805820" 
 Foreground="#FFEEECF3" Click="Button_Click_1"/>
                <Button Grid.Column="2" Margin="15,20" Content="Log out" FontSize="15" FontFamily="Arial" Background="#FF805820" 
Foreground="#FFEEECF3" Click="Button_Click_2" />
            </Grid>
        </Grid>

    </Grid>
</Page>
