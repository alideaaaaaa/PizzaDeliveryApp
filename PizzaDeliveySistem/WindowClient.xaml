<Window x:Class="PizzaDeliveySistem.WindowClient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PizzaDeliveySistem"
        mc:Ignorable="d"
        Title="WindowClient" Height="650" Width="920">
    
        <Grid  Background="Bisque" Height="650" Width="920">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Name="bttnAcasa" Click="bttnAcasa_Click">
                    <Border CornerRadius="40" Background="#FF805810" Width="250">
                        <TextBlock Text="Acasa" FontFamily="Arial" TextDecorations="Underline"
                    FontSize="25" Foreground="Bisque"  FontWeight="Bold" Margin="15" HorizontalAlignment="Center" />
                    </Border>
                </Button>

               
                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Click="Button_Click_1_Comenzi">
                    <Border CornerRadius="40" Background="#FF805810" Width="250">
                        <TextBlock Text="Comenzi" FontFamily="Arial" TextDecorations="Underline" HorizontalAlignment="Center"
           FontSize="25" Foreground="Bisque"  FontWeight="Bold" Margin="15" />
                    </Border>
                </Button>
                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Click="Button_Click_3_Cont">
                    <Border CornerRadius="40" Background="#FF805810" Width="250">
                        <TextBlock Text="Cont" FontFamily="Arial" TextDecorations="Underline" HorizontalAlignment="Center"
FontSize="25" Foreground="Bisque"  FontWeight="Bold" Margin="15" />
                    </Border>
                </Button>

            </Grid>
            <Frame x:Name="MainFrame" Grid.Row="1" Navigated="MainFrame_Navigate"/>
        </Grid>
    </Window>


