<Window x:Class="PizzaDeliveySistem.Alerta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PizzaDeliveySistem"
        mc:Ignorable="d"
        Title="Alerta" Height="154" Width="343"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Margin="10" FontFamily="Arial" Name="label1"/>
        <Button Grid.Row="1" Width="90" Height="30" Content="OK" Click="Button_Click"/>
    </Grid>
</Window>
