<Window x:Class="PizzaDeliveySistem.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PizzaDeliveySistem"
        mc:Ignorable="d"
        Title="Window3" Height="650" Width="920">
    <Grid  Background="Bisque" Height="650" Width="920">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Name="bttnAcasa" Click="bttnAcasa_Click">
                <Border CornerRadius="40" Background="#FF805810">
                    <TextBlock Text="Acasa" FontFamily="Arial" TextDecorations="Underline"
                    FontSize="25" Foreground="Bisque"  FontWeight="Bold" Margin="15"  />
                </Border>
            </Button>

            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Name="bttnUtilizatori" Click="bttnUtilizatori_Click_1" >
                <Border CornerRadius="40" Background="#FF805810">
                    <TextBlock Text="Utilizatori" FontFamily="Arial" TextDecorations="Underline"
          FontSize="25" Foreground="Bisque"  FontWeight="Bold" Margin="15" />
                </Border>
            </Button>

            <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Click="Button_Click">
                <Border CornerRadius="40" Background="#FF805810">
                    <TextBlock Text="Produse" FontFamily="Arial" TextDecorations="Underline"
           FontSize="25" Foreground="Bisque"  FontWeight="Bold" Margin="15" />
                </Border>
            </Button>
            <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Click="Button_Click_1">
                <Border CornerRadius="40" Background="#FF805810">
                    <TextBlock Text="Comenzi" FontFamily="Arial" TextDecorations="Underline"
FontSize="25" Foreground="Bisque"  FontWeight="Bold" Margin="15" />
                </Border>
            </Button>
            <Button Grid.Column="4" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Width="160" Click="Button_Click_2">
                <Border CornerRadius="40" Background="#FF805810">
                    <TextBlock Text="Statistici" FontFamily="Arial" TextDecorations="Underline"
FontSize="25" Foreground="Bisque"  FontWeight="Bold" Margin="15" />
                </Border>
            </Button>
            <Button Grid.Column="5" Background="Transparent" BorderThickness="0" Click="Button_Click_3">
                <Border CornerRadius="40" Background="#FF805810">
                    <TextBlock Text="Cont" FontFamily="Arial" TextDecorations="Underline"
FontSize="25" Foreground="Bisque"  FontWeight="Bold" Margin="15" />
                </Border>
            </Button>

        </Grid>
        <Frame x:Name="MainFrame" Grid.Row="1" Navigated="MainFrame_Navigate"/>
    </Grid>
</Window>
