<Window x:Class="PizzaDeliveySistem.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PizzaDeliveySistem"
        mc:Ignorable="d"
        Title="Window1" Height="500" Width="1000">
    <Grid Background="#FFE0C9A0">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Margin="20" Content="Va rugam introduceti datele personale" FontFamily="Arial"
               FontSize="30" Foreground="#FF805810"
           FontWeight="Bold"/>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
             <Label Grid.Row="0" Grid.Column="0" Content="Numele complet:" FontFamily="Arial" FontSize="20" Foreground="#FF805810" Name="labelNume" FontWeight="Bold"/>
            <Label Grid.Row="0" Grid.Column="1" Content="Email:" FontFamily="Arial" FontSize="20" Foreground="#FF805810" FontWeight="Bold" Name="labelEmail"/>
            <Label Grid.Row="0" Grid.Column="2" Content="Data nasterii:" FontFamily="Arial" FontSize="20" Foreground="#FF805810" FontWeight="Bold" Name="labelData"/>
            <Label Grid.Row="2" Grid.Column="0" Content="User name:" FontFamily="Arial" FontSize="20" Foreground="#FF805810" FontWeight="Bold" Name="labelUser"/>
            <Label Grid.Row="2" Grid.Column="1" Content="Parola:" FontFamily="Arial" FontSize="20" Foreground="#FF805810" FontWeight="Bold" Name="labelPass"/>
            <Label Grid.Row="2" Grid.Column="2" Content="Adresa:" FontFamily="Arial" FontSize="20" Foreground="#FF805810" FontWeight="Bold" Name="labelAdress"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,30,40" FontFamily="Arial" FontSize="20" Name="textBoxEmail"/>
            <TextBox Grid.Row="1" Grid.Column="0" Margin="0,10,30,40" FontFamily="Arial" FontSize="20" Name="textBoxNume"/>
            <DatePicker Grid.Row="1" Grid.Column="2" Margin="0,10,30,40" FontFamily="Arial" FontSize="20" Name="timePickerData"/>
            <TextBox Grid.Row="3" Grid.Column="0" Margin="0,10,30,40" FontFamily="Arial" FontSize="20" Name="textBoxUser"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,30,40" FontFamily="Arial" FontSize="20" Name="textBoxPass"/>
            <TextBox Grid.Row="3" Grid.Column="2" Margin="0,10,30,40" FontFamily="Arial" FontSize="20" Name="textBoxAdresa"/>
            <Button Grid.Column="2" Grid.Row="4" Margin="15,20" Content="Creare cont" FontSize="20" FontFamily="Arial" Background="#FF805820" 
 Foreground="#FFEEECF3" Click="Button_Click" />
        </Grid>
        
    </Grid>
        </Window>


