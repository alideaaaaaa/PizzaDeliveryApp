<Window x:Class="PizzaDeliveySistem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PizzaDeliveySistem"
        mc:Ignorable="d"
               Title="Window1" Height="500" Width="1000">
    <Grid Background="#FFE0C9A0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="1" Content="---Log In-----------------------------" FontFamily="Arial"
                           FontSize="40" Foreground="#FF805810"
                       FontWeight="Bold">
                </Label>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Label Margin="20,0,20,0" VerticalAlignment="Center" Content="Username" FontFamily="Arial" 
                           FontSize="25" Foreground="#FF805810" FontWeight="Bold"/>
                    <Label Grid.Row="1" Margin="20,30,20,0" VerticalAlignment="Top" Content="Parola" FontFamily="Arial" 
       FontSize="25" Foreground="#FF805810" FontWeight="Bold">
                    </Label>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Margin="10,40" Name="textBoxUsername" FontSize="30">
                    </TextBox>
                    <TextBox Grid.Row="1" Margin="10,25,10,50" Name="textBoxPass" FontSize="30">
                    </TextBox>
                </Grid>

            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="15,20" Content="Creare cont" FontSize="20" FontFamily="Arial" Background="#FF805820" 
                        Foreground="#FFEEECF3" Click="Button_Click" />
                <Button Grid.Column="1" Margin="15,20" Content="Autentificare" FontSize="20" FontFamily="Arial" Background="#FF805820" 
        Foreground="#FFEEECF3" Click="Button_Click_1" />
            </Grid>
        </Grid>
        <Image Grid.Column="1" Margin="20" Source="/PozePizza/PizzaDelivery.jpg">
        </Image>
    </Grid>
</Window>