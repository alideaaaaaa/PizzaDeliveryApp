<Page x:Class="PizzaDeliveySistem.Pizzaaa.MortadellaBuratta"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PizzaDeliveySistem.Pizzaaa"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="MortadellaBuratta">

    <Grid Background="Bisque" Height="450" Width="900">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Margin="30" Source="/PozePizza/pizzaMortadellaburatta.jpg" Stretch='UniformToFill'/>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>


            <TextBox Grid.Row="0" Name="textBoxNume" Margin="10" FontFamily="Arial"
                           FontSize="30" Foreground="#FF805810"
                       FontWeight="Bold" Background="Transparent" IsReadOnly="True" BorderThickness="0"/>
            <TextBox Grid.Row="1" Name="textBoxDescriere" FontFamily="Arial" FontSize="20" Margin="10" AcceptsReturn="True"
         TextWrapping="Wrap" Background="Transparent" Foreground="#ff805810" BorderThickness="0"/>
            <TextBox Grid.Row="2" Name="textBoxPrice"  Margin="10" FontFamily="Arial"
                           FontSize="30" Foreground="#FF805810"
                       FontWeight="Bold" Background="Transparent" BorderThickness="0"/>
            <Grid Grid.Row="3" HorizontalAlignment="Left" Width="550">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Margin="15,20" FontSize="20" FontFamily="Arial" Background="#FF805820" 
Foreground="#FFEEECF3" Click="Button_Click_1" Name="btn1" Content="Adauga in cos"/>
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="Cantitatea"  FontSize="20" Foreground="#FF805810" FontWeight="Bold"/>
                    <ListBox Grid.Row="1" Margin="10,0,10,20" Name="listCantitatea"/>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Page>
