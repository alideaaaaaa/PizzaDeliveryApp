<Page x:Class="PizzaDeliveySistem.PageStatistici"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PizzaDeliveySistem"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="PageStatistici" Background="Bisque" Width="900" Height="450">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Generale" FontFamily="Arial" FontSize="25" Foreground="#FF805810"  
                   FontWeight="Bold" VerticalAlignment="Center"/>
            <Label Grid.Row="1" Content="Comenzi active" FontFamily="Arial" FontSize="25" Foreground="#FF805810"  
       FontWeight="Bold" VerticalAlignment="Center"/>
            <Label Grid.Row="3" Content="Comenzi finaliate" FontFamily="Arial" FontSize="25" Foreground="#FF805810"  
       FontWeight="Bold" VerticalAlignment="Center"/>
            <Label Grid.Row="5" Content="Total incasari" FontFamily="Arial" FontSize="25" Foreground="#FF805810"  
       FontWeight="Bold" VerticalAlignment="Center"/>
            <Label Grid.Row="2" FontFamily="Arial" FontSize="25" Foreground="DarkOrange"
       FontWeight="Bold" VerticalAlignment="Center" Name="labelctive"/>
            <Label Grid.Row="4" FontFamily="Arial" FontSize="25" Foreground="DarkOrange"
FontWeight="Bold" VerticalAlignment="Center" Name="labelfinaliate"/>
            <Label Grid.Row="6" FontFamily="Arial" FontSize="25" Foreground="DarkOrange"
FontWeight="Bold" VerticalAlignment="Center" Name="labelTotal"/>
            
        </Grid>
        <lvc:CartesianChart Grid.Column="1"  x:Name="chart" Margin="20"/>
    </Grid>
</Page>
