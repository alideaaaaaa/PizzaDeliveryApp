<Page x:Class="PizzaDeliveySistem.IstoricPersonalComenziPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PizzaDeliveySistem"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="IstoricPersonalComenziPage">

    <Grid Background="Bisque" Height="450" Width="900">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0" Margin="20" FontFamily="Arial" FontSize="20" AutoGenerateColumns="False" Name="dataGrid" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50" />
                <DataGridTextColumn Header="Produse" Binding="{Binding Cos}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                <DataGridTextColumn Header="Data" Binding="{Binding DataComanda}" Width="*" />
                <DataGridTextColumn Header="Suma" Binding="{Binding Suma}" Width="*" />

            </DataGrid.Columns>
            
        </DataGrid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
                <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DatePicker Grid.Column="0" Margin="10,30" Name="dateTime1"/>
                <DatePicker Grid.Column="1" Margin="10,30" Name="dateTime2"/>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="15,20" Content="Resetare filtre" FontSize="15" FontFamily="Arial" Background="#FF805820" 
                Foreground="#FFEEECF3" Click="Button_Click" />
                <Button Grid.Column="1" Margin="15,20" Content="Cauta" FontSize="15" FontFamily="Arial" Background="#FF805820" 
Foreground="#FFEEECF3" Click="Button_Click_1" />
            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Margin="15,40" FontSize="15" FontFamily="Arial" Name="comboBox" />
                <Button Grid.Column="1" Margin="15,20" Content="Ordoneaza" FontSize="15" FontFamily="Arial" Background="#FF805820" 
Foreground="#FFEEECF3" Click="Button_Click_2" />
            </Grid>
        </Grid>
    </Grid>
</Page>
