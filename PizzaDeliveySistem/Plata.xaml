
    <Window x:Class="PizzaDeliveySistem.Plata"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plata Comandă"
        Height="300"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Bisque">

        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
       Content="Alege metoda de plată"
       FontFamily="Arial"
       FontSize="24"
       FontWeight="Bold"
       Foreground="#FF805810"
       HorizontalAlignment="Center"
       VerticalAlignment="Center"/>


        <StackPanel Grid.Row="1"
    VerticalAlignment="Center">

            <Label Name="cbOnline"
      Content="Plată Online"
      FontFamily="Arial"
      FontSize="18"
      FontWeight="Bold"
      Foreground="#FF805810"
      Margin="10"
      />

            <StackPanel Orientation="Horizontal"
        Margin="40,0,10,10">


                <TextBox Name="txtCard"
         Width="220"
         Height="30"
         FontSize="16"
         VerticalContentAlignment="Center"
         />
            </StackPanel>

            
        </StackPanel>
        <Button Grid.Row="2"
        Width="150"
        Height="40"
        Content="Confirmă"
        FontFamily="Arial"
        FontSize="16"
        FontWeight="Bold"
        Background="#FF805820"
        Foreground="#FFEEECF3"
        HorizontalAlignment="Center"
        Click="ButtonConfirma_Click"/>


    </Grid>
    </Window>
