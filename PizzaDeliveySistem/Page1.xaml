<Page x:Class="PizzaDeliveySistem.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PizzaDeliveySistem"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="Page1">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <Grid Background="Bisque" Width="900" Height="450">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Image Source="/PozePizza/margeritaGRID.jpg" Stretch='UniformToFill'/>
                <Button Grid.Row="1" Background="Transparent" BorderThickness="0" Click="Button_Click">
                    <Border CornerRadius="40" Background="#FF805810" Width="177">
                        <TextBlock Text="Margarita" FontFamily="Arial" 
        FontSize="20" Foreground="Bisque"  FontWeight="Bold" Margin="10" TextAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Image Source="/PozePizza/crudoGRID.jpg" Stretch='Uniform'/>
                <Button Grid.Row="1" Background="Transparent" BorderThickness="0" Click="Button_Click_1">
                    <Border CornerRadius="40" Background="#FF805810" Width="177">
                        <TextBlock Text="Posciutto Crudo" FontFamily="Arial" 
        FontSize="20" Foreground="Bisque"  FontWeight="Bold" Margin="10" TextAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Image Source="/PozePizza/napoletanaGRID.jpg" Stretch='UniformToFill'/>
                <Button Grid.Row="1" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Width="205" Click="Button_Click_2">
                    <Border CornerRadius="40" Background="#FF805810" Width="177">
                        <TextBlock Text="Napoletana" FontFamily="Arial" 
        FontSize="20" Foreground="Bisque"  FontWeight="Bold" Margin="10" TextAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="3" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Image Source="/PozePizza/capriciosaGRID.jpg" Stretch='UniformToFill'/>
                <Button Grid.Row="1" Background="Transparent" BorderThickness="0" Click="Button_Click_3">
                    <Border CornerRadius="40" Background="#FF805810" Width="177">
                        <TextBlock Text="Capriciosa" FontFamily="Arial" 
 FontSize="20" Foreground="Bisque"  FontWeight="Bold" Margin="10" TextAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Image Source="/PozePizza/peperoniGRID.jpg" Stretch='UniformToFill'/>
                <Button Grid.Row="1" Background="Transparent" BorderThickness="0" Click="Button_Click_4">
                    <Border CornerRadius="40" Background="#FF805810" Width="177">
                        <TextBlock Text="Peperoni" FontFamily="Arial" 
FontSize="20" Foreground="Bisque"  FontWeight="Bold" Margin="10" TextAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Image Source="/PozePizza/pizzaQuattroformaggi.jpg" Stretch='UniformToFill'/>
                <Button Grid.Row="1" Background="Transparent" BorderThickness="0" Click="Button_Click_5">
                    <Border CornerRadius="40" Background="#FF805810" Width="177">
                        <TextBlock Text="Quattro Formaggi" FontFamily="Arial" 
FontSize="18" Foreground="Bisque"  FontWeight="Bold" Margin="10" TextAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Image Source="/PozePizza/mortadellaGRID.jpg" Stretch='UniformToFill'/>
                <Button Grid.Row="1" Background="Transparent" BorderThickness="0" Click="Button_Click_6">
                    <Border CornerRadius="40" Background="#FF805810" Width="177">
                        <TextBlock Text="Mortadella Buratta" FontFamily="Arial" 
FontSize="18" Foreground="Bisque"  FontWeight="Bold" Margin="10" TextAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="3" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Image Source="/PozePizza/pestoGRID.jpg" Stretch='UniformToFill'/>
                <Button Grid.Row="1" Background="Transparent" BorderThickness="0" Click="Button_Click_7">
                    <Border CornerRadius="40" Background="#FF805810" Width="177">
                        <TextBlock Text="Pesto" FontFamily="Arial" 
FontSize="20" Foreground="Bisque"  FontWeight="Bold" Margin="10" TextAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>

        </Grid>
    </ScrollViewer>
</Page>
