<Window x:Class="PizzaDeliveySistem.WindowAddProdus"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PizzaDeliveySistem"
        mc:Ignorable="d"
        Title="WindowAddProdus" Height="450" Width="500">
    <Grid Background="Bisque">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Content="Detalii produs" FontFamily="Arial" FontSize="28" Foreground="DarkOrange"  
        FontWeight="Bold" VerticalAlignment="Center"/>
        <Label Grid.Row="1" Grid.Column="0" Content="Tip pizza" FontFamily="Arial" FontSize="20" Foreground="#FF805810"  
 FontWeight="Bold" VerticalAlignment="Center"/>
        <Label Grid.Row="2" Grid.Column="0" Content="Pret" FontFamily="Arial" FontSize="20" Foreground="#FF805810"  
 FontWeight="Bold" VerticalAlignment="Center"/>
        <Label Grid.Row="3" Grid.Column="0" Content="Numar bucati" FontFamily="Arial" FontSize="20" Foreground="#FF805810"  
 FontWeight="Bold" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1"  FontFamily="Arial" FontSize="20"  VerticalAlignment="Center" Margin="20,10" Name="comboBox"/>
        <TextBox Grid.Row="2" Grid.Column="1"  FontFamily="Arial" FontSize="20"  VerticalAlignment="Center" Margin="20,10" Name="textBox"/>
        <ComboBox Grid.Row="3" Grid.Column="1"  FontFamily="Arial" FontSize="20"  VerticalAlignment="Center" Margin="20,10" Name="comboBox2"/>

        <Button Grid.Column="1" Grid.Row="4" Margin="15,20" FontSize="20" FontFamily="Arial" Background="#FF805820" 
Foreground="#FFEEECF3" Click="Button_Click_1" Name="btn1" Content="Adauga"/>
    </Grid>
</Window>
